<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-code-clustering-lsp</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Apache Maven Code Clustering: Language Server Front End</name>
  <description>An AtomFrontEnd for maven-code-clustering-plugin that asks language servers (through Eclipse LSP4J)
    for document symbols: any language with a server (clangd, rust-analyzer, Eclipse JDT LS, LemMinX, pyright, gopls)
    is atomized by its own language core. Add it as a dependency of the plugin. It also holds a code-clustering
    language server that shows the plugin's duplicates as diagnostics in any LSP client.</description>
  <licenses>
    <license><name>Apache-2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url></license>
  </licenses>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <lsp4jVersion>0.23.1</lsp4jVersion>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.apache.maven.plugins</groupId>
      <artifactId>maven-code-clustering-plugin</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
    <!-- Eclipse LSP4J, EPL-2.0 (binary dependency); see README for the notice. -->
    <dependency>
      <groupId>org.eclipse.lsp4j</groupId>
      <artifactId>org.eclipse.lsp4j</artifactId>
      <version>${lsp4jVersion}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <compilerArgs><arg>-Xlint:all,-processing,-classfile</arg><arg>-Werror</arg></compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>lsp-front-end-tests</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.apache.maven.plugins.clustering.lsp.LspFrontEndTest</mainClass>
              <classpathScope>test</classpathScope>
              <arguments><argument>${project.build.directory}/lsp-test</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>command-line-tests</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.apache.maven.plugins.clustering.lsp.CommandLineTest</mainClass>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
          <execution>
            <id>server-profile-tests</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.apache.maven.plugins.clustering.lsp.ServerProfilesTest</mainClass>
              <classpathScope>test</classpathScope>
              <arguments><argument>${project.build.directory}/profiles-test</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>symbol-mapping-tests</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.apache.maven.plugins.clustering.lsp.SymbolMappingTest</mainClass>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
          <execution>
            <!-- Real servers when installed, else SKIP; -Dclustering.test.servers=<dir> adds an install directory. -->
            <id>real-server-tests</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.apache.maven.plugins.clustering.lsp.RealServersTest</mainClass>
              <classpathScope>test</classpathScope>
              <arguments><argument>${project.build.directory}/real-servers</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>language-server-tests</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.apache.maven.plugins.clustering.lsp.ClusteringLanguageServerTest</mainClass>
              <classpathScope>test</classpathScope>
              <arguments><argument>${project.build.directory}/language-server-test</argument></arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
