<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Explicit opt-in. Importing this file does not modify Build or Clean. -->
  <PropertyGroup>
    <M3MavenExecutable Condition="'$(M3MavenExecutable)' == ''">mvn.cmd</M3MavenExecutable>
    <M3MavenPom Condition="'$(M3MavenPom)' == ''">$(MSBuildProjectDirectory)\pom.xml</M3MavenPom>
    <M3MavenGoals Condition="'$(M3MavenGoals)' == ''">verify</M3MavenGoals>
  </PropertyGroup>
  <Target Name="M3MavenVerify" Condition="'$(M3MavenEnable)' == 'true'">
    <Error Condition="!Exists('$(M3MavenPom)')" Text="M3 Maven POM was not found: $(M3MavenPom)" />
    <Exec Command="&quot;$(M3MavenExecutable)&quot; -B -ntp -f &quot;$(M3MavenPom)&quot; $(M3MavenGoals)"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          IgnoreExitCode="false" />
  </Target>
</Project>
