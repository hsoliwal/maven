<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.maven.mcp</groupId>
  <artifactId>maven-mcp-server</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Apache Maven MCP Server</name>
  <description>A Model Context Protocol server on stdio that lets coding agents build and test a Maven project and
    read the results as compact JSON: build, test, effective POM, dependency tree, goal descriptions, modules, the
    build event stream and the failure digest. Builds run as a child process of the Maven distribution's own
    launcher, with an argument vector and no shell command line.</description>
  <licenses>
    <license><name>Apache-2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url></license>
  </licenses>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mcpSdkVersion>2.1.0</mcpSdkVersion>
    <slf4jVersion>2.0.16</slf4jVersion>
    <mcp.test.scratch>${java.io.tmpdir}/llm-mcp</mcp.test.scratch>
  </properties>
  <dependencies>
    <!-- MCP Java SDK, MIT (binary dependency); see FOSS_REUSE_DECISION.tsv and README for the notice. -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-core</artifactId>
      <version>${mcpSdkVersion}</version>
    </dependency>
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-json-jackson2</artifactId>
      <version>${mcpSdkVersion}</version>
    </dependency>
    <!-- MavenCommands of the build events extension: the one owner of the test and integration-test spelling.
         Only that class is shaded into the server jar (see the shade filter). -->
    <dependency>
      <groupId>io.synexia</groupId>
      <artifactId>smart-maven-extension</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <!-- The SDK logs through SLF4J; this routes it to java.util.logging, which writes to stderr. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <version>${slf4jVersion}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <compilerArgs><arg>-Xlint:all,-processing,-classfile</arg><arg>-Werror</arg></compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration><skip>true</skip></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest><addDefaultImplementationEntries>true</addDefaultImplementationEntries></manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <version>3.1.4</version>
      </plugin>
      <plugin>
        <!-- One runnable jar: java -jar maven-mcp-server-<version>.jar -root <project> -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>io.synexia:smart-maven-extension</artifact>
                  <includes>
                    <include>org/apache/maven/agent/events/MavenCommands.class</include>
                  </includes>
                </filter>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- META-INF/LICENSE (Apache-2.0) and META-INF/THIRD-PARTY-NOTICES.txt come from this module;
                     the project's copy wins over the dependencies' Apache-2.0 LICENSE files. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.apache.maven.mcp.MavenMcpMain</mainClass>
                  <manifestEntries><Multi-Release>true</Multi-Release></manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>argument-guard-tests</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.apache.maven.mcp.ArgumentGuardTest</mainClass>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
          <execution>
            <id>result-reader-tests</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.apache.maven.mcp.ResultReadersTest</mainClass>
              <classpathScope>test</classpathScope>
              <arguments><argument>${project.build.directory}/result-readers-test</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <!-- Starts the shaded jar on stdio and drives it with MCP messages against a scratch reactor. -->
            <id>protocol-tests</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.apache.maven.mcp.McpProtocolTest</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                <argument>${mcp.test.scratch}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
