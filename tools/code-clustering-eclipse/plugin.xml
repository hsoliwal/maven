<plugin>
   <!--
   One code-clustering server for the whole workspace (singleton): LSP4E sends every open project as a workspace
   folder, and the server scans them all. A mapping whose content type is not installed is skipped by LSP4E.
   The README lists the upstream file that declares each content type.
   -->
   <extension point="org.eclipse.lsp4e.languageServer">
      <server
            id="org.apache.maven.plugins.clustering.eclipse.server"
            label="Code Clustering"
            class="org.apache.maven.plugins.clustering.eclipse.ClusteringConnectionProvider"
            singleton="true"/>
      <!-- JDT -->
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.jdt.core.javaSource" languageId="java"/>
      <!-- CDT -->
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.cdt.core.cSource" languageId="c"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.cdt.core.cHeader" languageId="c"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.cdt.core.cxxSource" languageId="cpp"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.cdt.core.cxxHeader" languageId="cpp"/>
      <!-- PyDev -->
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.python.pydev.pythonfile" languageId="python"/>
      <!-- XML: the platform type (Wild Web Developer / LemMinX) and the WTP XML editor's type -->
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.core.runtime.xml" languageId="xml"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.wst.xml.core.xmlsource" languageId="xml"/>
      <!-- HTML, CSS, JSON: WTP source editing, and the TM4E types that Wild Web Developer uses -->
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.wst.html.core.htmlsource" languageId="html"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.tm4e.language_pack.html" languageId="html"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.wst.css.core.csssource" languageId="css"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.tm4e.language_pack.css" languageId="css"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.wst.json.core.jsonsource" languageId="json"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.tm4e.language_pack.json" languageId="json"/>
      <!-- JavaScript and TypeScript: WTP JSDT, and the TM4E types that Wild Web Developer uses -->
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.wst.jsdt.core.jsSource" languageId="javascript"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.tm4e.language_pack.javascript" languageId="javascript"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.tm4e.language_pack.javascriptreact" languageId="javascriptreact"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.tm4e.language_pack.typescript" languageId="typescript"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.tm4e.language_pack.typescriptreact" languageId="typescriptreact"/>
      <!-- Rust: Corrosion (TM4E type) and RustDT -->
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="org.eclipse.tm4e.language_pack.rust" languageId="rust"/>
      <contentTypeMapping id="org.apache.maven.plugins.clustering.eclipse.server"
            contentType="com.github.rustdt.ide.core.content.source" languageId="rust"/>
   </extension>
</plugin>
