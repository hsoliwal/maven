Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Apache Maven Code Clustering: Eclipse LSP4E Connector
Bundle-SymbolicName: org.apache.maven.plugins.clustering.eclipse;
 singleton:=true
