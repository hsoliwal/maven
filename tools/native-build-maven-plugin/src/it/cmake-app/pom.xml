A CMake program that depends on cmake-lib's attached zip. The plugin unpacks the zip into
target/native/deps/<groupId>/<artifactId>/<classifier> and passes it as CMAKE_PREFIX_PATH; nothing reaches into a sibling's
target. Built with cmake-lib in the native-reactor aggregator (mvn package, also with -T).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.maven.plugins.it.nativebuild</groupId>
  <artifactId>cmake-app</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>
  <properties>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <fx.classifier>linux-x86_64</fx.classifier>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.apache.maven.plugins.it.nativebuild</groupId>
      <artifactId>cmake-lib</artifactId>
      <version>1.0</version>
      <type>zip</type>
      <classifier>${fx.classifier}</classifier>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-native-build-plugin</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <executions>
          <execution>
            <goals>
              <goal>configure</goal>
              <goal>build</goal>
              <goal>test</goal>
              <goal>stage</goal>
              <goal>attach</goal>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>mingw</id>
      <activation><os><family>windows</family></os></activation>
      <properties><fx.classifier>windows-x86_64-mingw</fx.classifier></properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-native-build-plugin</artifactId>
            <configuration>
              <cmakeGenerator>Ninja</cmakeGenerator>
              <tools><cc>gcc</cc></tools>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
