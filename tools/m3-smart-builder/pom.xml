<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.synexia</groupId>
  <artifactId>m3-smart-maven-plugin</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>maven-plugin</packaging>
  <name>Synexia M3 Smart Maven Builder (opt-in)</name>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <m3.smart.mindexdbClasspath>${project.build.directory}/mindexdb-provider</m3.smart.mindexdbClasspath>
  </properties>
  <dependencies>
    <dependency><groupId>org.apache.maven</groupId><artifactId>maven-plugin-api</artifactId><version>3.9.9</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.maven.plugin-tools</groupId><artifactId>maven-plugin-annotations</artifactId><version>3.15.2</version><scope>provided</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-plugin-plugin</artifactId><version>3.15.2</version>
      <configuration><goalPrefix>m3</goalPrefix></configuration>
      <executions><execution><id>descriptor</id><goals><goal>descriptor</goal></goals></execution></executions>
    </plugin>
    <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
      <executions><execution><id>core-offline-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration>
          <mainClass>io.synexia.maven.smart.SmartBuilderTest</mainClass><classpathScope>test</classpathScope>
          <systemProperties><systemProperty><key>m3.smart.testRoot</key><value>${project.build.directory}</value></systemProperty></systemProperties>
        </configuration>
      </execution>
      <execution><id>build-hook-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration><mainClass>io.synexia.maven.smart.BuildHookTest</mainClass><classpathScope>test</classpathScope></configuration>
      </execution>
      <execution><id>atom-pattern-evidence-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration><mainClass>io.synexia.maven.smart.AtomPatternEvidenceTest</mainClass><classpathScope>test</classpathScope></configuration>
      </execution>
      <execution><id>canon-gate-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration><mainClass>io.synexia.maven.smart.canon.CanonGateTest</mainClass><classpathScope>test</classpathScope></configuration>
      </execution>
      <execution><id>canonical-preparation-evidence-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration><mainClass>io.synexia.maven.smart.CanonicalPreparationEvidenceTestMain</mainClass>
          <classpathScope>test</classpathScope></configuration>
      </execution>
      <execution><id>code-agent-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration><mainClass>io.synexia.maven.smart.CodeAgentTest</mainClass>
          <classpathScope>test</classpathScope></configuration>
      </execution>
      <execution><id>code-agent-verify-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration><mainClass>io.synexia.maven.smart.CodeAgentVerifyTest</mainClass>
          <classpathScope>test</classpathScope></configuration>
      </execution>
      <execution><id>machine-rulebook-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration><mainClass>io.synexia.maven.smart.MachineRulebookTest</mainClass>
          <classpathScope>test</classpathScope></configuration>
      </execution>
      <execution><id>machine-fingerprint-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration><mainClass>io.synexia.maven.smart.MachineFingerprintTest</mainClass>
          <classpathScope>test</classpathScope></configuration>
      </execution>
      <execution><id>machine-operator-catalog-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration><mainClass>io.synexia.maven.smart.MachineOperatorCatalogTest</mainClass>
          <classpathScope>test</classpathScope></configuration>
      </execution>
      <execution><id>machine-operator-proof-registry-tests</id><phase>verify</phase><goals><goal>java</goal></goals>
        <configuration><mainClass>io.synexia.maven.smart.MachineOperatorProofRegistryTest</mainClass>
          <classpathScope>test</classpathScope></configuration>
      </execution></executions>
    </plugin>
  </plugins></build>
  <profiles>
    <profile>
      <id>m3-module-db</id>
      <build><plugins>
        <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
          <executions><execution><id>m3-module-db-native-tests</id><phase>verify</phase><goals><goal>exec</goal></goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-classpath</argument>
                <argument>${project.build.outputDirectory}${path.separator}${project.build.testOutputDirectory}${path.separator}${m3.smart.mindexdbClasspath}</argument>
                <argument>io.synexia.maven.smart.ModuleFingerprintDatabaseTest</argument>
              </arguments>
            </configuration>
          </execution></executions>
        </plugin>
      </plugins></build>
    </profile>
  </profiles>
</project>
