<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-polyglot-tool-adapters</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Apache Maven Polyglot Tool Adapters</name>
  <description>Opt-in M3 tool providers for the polyglot engine: a text differ (git), the structural differ and
    atomizer of the code clustering plugin, the code patch plugin as patcher, a javac plug-in host as static analyzer
    (Error Prone and other javac plug-ins on the compiler's own AST, findings as SARIF 2.1.0 and build-events lines) and
    a language-server linter (diagnostics collected over LSP). Providers plan argv only; every tool runs in its own
    process.</description>
  <licenses>
    <license><name>Apache-2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url></license>
  </licenses>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <lsp4jVersion>0.23.1</lsp4jVersion>
  </properties>
  <dependencies>
    <dependency>
      <!-- The SPI; the engine is always present where providers are loaded. -->
      <groupId>io.synexia</groupId>
      <artifactId>m3-polyglot-maven-plugin</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- Only LspDiagnosticsMain uses it, in its own process; the host names the jars in the task (jar=...). -->
      <groupId>org.eclipse.lsp4j</groupId>
      <artifactId>org.eclipse.lsp4j</artifactId>
      <version>${lsp4jVersion}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration><release>17</release></configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>tool-adapters-contract</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.apache.maven.plugins.polyglot.adapters.ToolAdaptersContractTestMain</mainClass>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
