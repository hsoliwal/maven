<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-project-db-plugin</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>maven-plugin</packaging>
  <name>Apache Maven Project Database Plugin</name>
  <description>Per-project build database: ingests the build data a project already produces (polyglot task state,
    test reports, effective POM, dependency tree, code-clustering tables, build events, build log) into one M3IndexDB
    store, incrementally by content hash, and answers questions over it with CPU-only deterministic retrieval (BM25,
    hashing vectors, exact facets). Every answer carries its provenance: file, line and build id.</description>
  <licenses>
    <license><name>Apache-2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url></license>
  </licenses>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mavenVersion>3.9.9</mavenVersion>
    <pluginToolsVersion>3.15.2</pluginToolsVersion>
  </properties>
  <dependencies>
    <!-- The one storage owner (IndexStore over M3IndexDB) and the polyglot task-state reader. -->
    <dependency>
      <groupId>io.synexia</groupId>
      <artifactId>m3-polyglot-maven-plugin</artifactId>
      <version>0.1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${mavenVersion}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>${mavenVersion}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-model</artifactId>
      <version>${mavenVersion}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${pluginToolsVersion}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${pluginToolsVersion}</version>
        <configuration><goalPrefix>project-db</goalPrefix></configuration>
        <executions>
          <execution><id>descriptor</id><goals><goal>descriptor</goal></goals></execution>
        </executions>
      </plugin>
      <plugin>
        <!-- License gate of this module: the root reactor's RAT run skips module directories, and this POM has no
             parent, so the check is bound here. Exclusions are the root POM's for the same file kinds. -->
        <groupId>org.apache.rat</groupId>
        <artifactId>apache-rat-plugin</artifactId>
        <version>0.18</version>
        <configuration>
          <inputExcludes>
            <!-- FOSS reuse decision table (tab-separated, no comment syntax); attribution is in the README. -->
            <exclude>FOSS_REUSE_DECISION.tsv</exclude>
            <!-- MCP tool definitions (JSON has no comment syntax); attribution is in the adjacent sources. -->
            <exclude>src/main/resources/META-INF/project-db/mcp-tools.json</exclude>
            <!-- Test project inputs, as excluded by the root POM. -->
            <exclude>src/test/projects/**</exclude>
          </inputExcludes>
        </configuration>
        <executions>
          <execution>
            <id>license-gate</id>
            <phase>validate</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>project-db-tests</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.apache.maven.plugins.projectdb.ProjectDbTest</mainClass>
              <classpathScope>test</classpathScope>
              <arguments><argument>${project.build.directory}/project-db-test</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>gradle-native-evidence-contract</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.apache.maven.plugins.projectdb.GradleProjectDbContractTestMain</mainClass>
              <classpathScope>test</classpathScope>
              <arguments><argument>${project.build.directory}/gradle-project-db-test</argument></arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
