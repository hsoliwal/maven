            <phase>verify</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <arguments>
                <argument>-Dderby.stream.error.field=java.lang.System.err</argument>
                <argument>-classpath</argument><classpath/>
                <argument>io.synexia.maven.polyglot.M3PortableEngineConformanceTestMain</argument>
