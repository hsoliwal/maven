<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.maven.plugins</groupId>
  <artifactId>maven-code-clustering-plugin</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>maven-plugin</packaging>
  <name>Apache Maven Code Clustering Plugin</name>
  <description>Splits Java sources into type and method atoms, hashes each on four planes (exact text, logic with
    declared names abstracted, structure, SimHash) and reports clusters of duplicated or similar code, and how much of
    one source set another already holds. Reports only; it never changes a source file.</description>
  <licenses>
    <license><name>Apache-2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0.txt</url></license>
  </licenses>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mavenVersion>3.9.9</mavenVersion>
    <pluginToolsVersion>3.15.2</pluginToolsVersion>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
      <version>${mavenVersion}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.plugin-tools</groupId>
      <artifactId>maven-plugin-annotations</artifactId>
      <version>${pluginToolsVersion}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <compilerArgs><arg>-Xlint:all</arg><arg>-Werror</arg></compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${pluginToolsVersion}</version>
        <configuration><goalPrefix>code-clustering</goalPrefix></configuration>
        <executions>
          <execution><id>descriptor</id><goals><goal>descriptor</goal></goals></execution>
        </executions>
      </plugin>
      <!-- The javac plugin's service registration goes into the jar only, never into target/classes: javac reads
           the com.sun.source.util.Plugin services of its class path even without -Xplugin, and fails on a
           registration whose class is missing, as it is while this module compiles or when an incremental compile has
           just deleted the old classes. The jar is made from target/jar, a copy of target/classes plus the
           registration. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <id>jar-content</id>
            <phase>prepare-package</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/jar</outputDirectory>
              <resources>
                <resource><directory>${project.build.outputDirectory}</directory></resource>
                <resource><directory>src/main/javac-plugin</directory></resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration><classesDirectory>${project.build.directory}/jar</classesDirectory></configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>code-clustering-tests</id>
            <phase>verify</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>org.apache.maven.plugins.clustering.CodeClusteringTest</mainClass>
              <classpathScope>test</classpathScope>
              <arguments><argument>${project.build.directory}/code-clustering-test</argument></arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
