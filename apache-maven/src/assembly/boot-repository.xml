<!--
  The boot repository: the inline plugins and every artifact their default-lifecycle runs load, captured by
  the seed run of profile 'plugins' into target/boot-repository. It ships as repository/ (Maven 2 layout,
  read-only), chained as the local-repository tail by conf/maven-boot-repository.properties.
-->
<component xmlns="http://maven.apache.org/ASSEMBLY-COMPONENT/2.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/ASSEMBLY-COMPONENT/2.1.0 http://maven.apache.org/xsd/assembly-component-2.1.0.xsd">
  <fileSets>
    <fileSet>
      <directory>target/boot-repository</directory>
      <outputDirectory>repository</outputDirectory>
      <excludes>
        <!-- resolver bookkeeping of the capture run -->
        <exclude>**/_remote.repositories</exclude>
        <exclude>**/*.lastUpdated</exclude>
        <exclude>**/resolver-status.properties</exclude>
        <exclude>.locks/**</exclude>
        <exclude>.meta/**</exclude>
        <!-- the distribution's own POMs (installed by invoker:install) and the seeds' own install output -->
        <exclude>org/apache/maven/apache-maven/**</exclude>
        <exclude>org/apache/maven/maven/**</exclude>
        <exclude>org/example/**</exclude>
        <!-- JUnit jars (EPL-2.0) are not bundled: surefire aligns them with each project's JUnit version.
             org.eclipse.sisu.plexus (EPL-2.0, the licence of the Sisu jars already in lib/) stays: the
             maven-resources-plugin closure (plexus-build-api) needs it for an offline build. -->
        <exclude>org/junit/**/*.jar</exclude>
      </excludes>
    </fileSet>
    <!-- repository/<artifactId>.license: the license texts of the jars listed in the LICENSE repository/ section,
         written by LICENSE.vm (process-resource-bundles with bootRepository=true) -->
    <fileSet>
      <directory>target/licenses/repository</directory>
      <outputDirectory>repository</outputDirectory>
      <includes>
        <include>*.license</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>src/assembly/boot-repository</directory>
      <outputDirectory>conf</outputDirectory>
      <includes>
        <include>maven-boot-repository.properties</include>
      </includes>
    </fileSet>
  </fileSets>
</component>
