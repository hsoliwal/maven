<!--
  Seed without dependencies: the default lifecycle of a jar project (clean, resources, compiler, surefire,
  jar, install, deploy). It is the offline acceptance project: with an empty local repository and -o, the
  boot repository alone must serve every plugin it runs.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.example.boot</groupId>
  <artifactId>jar-offline</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <distributionManagement>
    <repository>
      <id>seed-deploy</id>
      <url>${project.baseUri}target/deploy-repo</url>
    </repository>
  </distributionManagement>
</project>
