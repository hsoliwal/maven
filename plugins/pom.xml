<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.maven</groupId>
    <artifactId>maven</artifactId>
    <version>4.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>maven-inline-plugins</artifactId>
  <packaging>pom</packaging>

  <name>Maven Inline Plugins</name>
  <description>Aggregates the plugin repositories imported with full history under plugins/. Built only with
    -Pplugins. Each imported reactor keeps its upstream parent and build; this POM only lists them.</description>

  <!-- Batch 1: the default-lifecycle plugins. The version of each is the fork reactor version. -->
  <modules>
    <module>maven-clean-plugin</module>
    <module>maven-resources-plugin</module>
    <module>maven-compiler-plugin</module>
    <module>maven-jar-plugin</module>
    <module>maven-install-plugin</module>
    <module>maven-deploy-plugin</module>
    <module>maven-surefire</module>
  </modules>

  <properties>
    <!-- Inline atomizer: wired off. The atomizer javac plugin is added to compiler runs under plugins/ when its
         lane lands; until then nothing reads this property. -->
    <inline.atomizer>false</inline.atomizer>
  </properties>
</project>
